# Copy to .env (or set as system environment variables) for production.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=medical-id.example.com
DJANGO_CSRF_ORIGINS=https://medical-id.example.com

# Local AI (Ollama). AI_ENABLED=0 uses the built-in rule engine only.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3
AI_ENABLED=1
AI_TIMEOUT=90

# Web push (PWA). Keys are generated automatically into VAPID_DIR on first use.
PUSH_ENABLED=1
VAPID_SUBJECT=mailto:admin@example.com

# Rate limits
THROTTLE_AUTH=30/min
THROTTLE_AI=30/min
